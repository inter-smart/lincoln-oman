# Copy to .env.local and fill in. Never commit real values.

# PHP CMS API — server-only: do NOT prefix with NEXT_PUBLIC_ (the token must never reach the browser).
CMS_API_URL=https://lincoln.dev2.intersmarthosting.in/api
CMS_API_TOKEN=
# Host the CMS serves images from, allowed in next/image remotePatterns.
CMS_MEDIA_HOST=https://lincoln.dev2.intersmarthosting.in

# Public site settings (see src/data/seo.js)
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_ALLOW_INDEXING=
